.tracking-settings-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

.tracking-settings-scroll {
    flex-grow: 1;
    padding: 8px 12px;
}

.tracking-page-title {
    font-size: 19px;
    -unity-font-style: bold;
    color: var(--unity-colors-default-text, #ffffff);
    margin-bottom: 8px;
    flex-shrink: 0;
}

.tracking-section-card {
    background-color: var(--unity-colors-helpbox-background, rgba(0, 0, 0, 0.15));
    border-width: 1px;
    border-color: var(--unity-colors-helpbox-border, rgba(0, 0, 0, 0.25));
    border-radius: 5px;
    padding: 8px 10px;
    margin-top: 8px;
    max-width: 100%;
    flex-shrink: 0;
}

.tracking-section-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--unity-colors-default-text, #e0e0e0);
    margin-bottom: 4px;
    flex-shrink: 0;
}

.tracking-section-subtitle {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--unity-colors-default-text, #d0d0d0);
    margin-bottom: 2px;
}

.tracking-hint-text {
    color: var(--unity-colors-default-text-hover, #999999);
    font-size: 11px;
    white-space: normal;
    margin-bottom: 4px;
}

.tracking-status-banner {
    margin-top: 6px;
    margin-bottom: 6px;
    padding: 6px 10px;
    border-radius: 4px;
    border-width: 1px;
    font-size: 11px;
    white-space: normal;
}

.tracking-status-active {
    background-color: rgba(46, 125, 50, 0.18);
    border-color: #388e3c;
    color: #388e3c;
}

.tracking-status-inactive {
    background-color: rgba(255, 152, 0, 0.15);
    border-color: #f57c00;
    color: #e65100;
}

.tracking-status-pending {
    background-color: rgba(33, 150, 243, 0.18);
    border-color: #1976d2;
    color: #1565c0;
}

.tracking-btn {
    height: 26px;
    border-radius: 4px;
    -unity-font-style: bold;
    margin-top: 4px;
    flex-shrink: 0;
}

.tracking-fields-container {
    margin-top: 4px;
    margin-bottom: 4px;
    max-width: 100%;
}

.tracking-fields-container > * {
    margin-bottom: 2px;
    max-width: 100%;
}

.tracking-fields-container .unity-base-field__input {
    flex-shrink: 1;
    min-width: 0;
}
