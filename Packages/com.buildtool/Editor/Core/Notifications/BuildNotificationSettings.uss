.notif-settings-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

.notif-settings-scroll {
    flex-grow: 1;
    padding: 8px 12px;
}

.notif-page-title {
    font-size: 19px;
    -unity-font-style: bold;
    color: var(--unity-colors-default-text, #ffffff);
    margin-bottom: 4px;
    flex-shrink: 0;
}

.notif-page-subtitle {
    font-size: 11px;
    color: var(--unity-colors-default-text-hover, #999999);
    margin-bottom: 12px;
    white-space: normal;
}

.notif-header-toggle {
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 8px;
    flex-shrink: 0;
}

.notif-channel-card {
    background-color: var(--unity-colors-helpbox-background, rgba(0, 0, 0, 0.15));
    border-width: 1px;
    border-color: var(--unity-colors-helpbox-border, rgba(0, 0, 0, 0.25));
    border-radius: 6px;
    padding: 10px 12px;
    margin-top: 10px;
    max-width: 100%;
    flex-shrink: 0;
}

.notif-channel-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4px;
}

.notif-channel-title-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
}

.notif-channel-dot {
    width: 10px;
    height: 10px;
    min-width: 10px;
    min-height: 10px;
    border-radius: 5px;
    margin-right: 8px;
    flex-shrink: 0;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.25);
}

.notif-channel-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--unity-colors-default-text, #e8e8e8);
}

.notif-channel-desc {
    font-size: 11px;
    color: var(--unity-colors-default-text-hover, #888888);
    white-space: normal;
    margin-bottom: 8px;
}

.notif-row {
    flex-direction: row;
    align-items: center;
    max-width: 100%;
    margin-top: 4px;
    margin-bottom: 4px;
}

.notif-field-flex {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 6px;
}

.notif-field-flex > .unity-base-field__input {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.notif-masked-container {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    background-color: var(--unity-colors-input_field-background, rgba(0, 0, 0, 0.2));
    border-width: 1px;
    border-color: var(--unity-colors-input_field-border, rgba(0, 0, 0, 0.3));
    border-radius: 3px;
    padding: 2px 6px;
    margin-right: 6px;
    min-height: 20px;
    overflow: hidden;
}

.notif-masked-label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    color: var(--unity-colors-default-text, #cccccc);
    -unity-text-align: middle-left;
    letter-spacing: 2px;
    overflow: hidden;
}

.notif-env-badge {
    background-color: #2b5b84;
    color: #ffffff;
    font-size: 9px;
    -unity-font-style: bold;
    padding: 1px 5px;
    border-radius: 3px;
    margin-left: 6px;
    flex-shrink: 0;
}

.notif-btn {
    height: 22px;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 3px;
    font-size: 11px;
    flex-shrink: 0;
}

.notif-btn-sm {
    height: 20px;
    width: 22px;
    min-width: 22px;
    padding: 0;
    margin-left: 4px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.notif-test-btn {
    height: 24px;
    margin-top: 6px;
    padding-left: 12px;
    padding-right: 12px;
    align-self: flex-start;
    -unity-font-style: bold;
    font-size: 11px;
    flex-shrink: 0;
}

.notif-status-banner {
    margin-top: 6px;
    padding: 5px 8px;
    border-radius: 4px;
    border-width: 1px;
    font-size: 11px;
}

.notif-status-success {
    background-color: rgba(46, 125, 50, 0.2);
    border-color: #388e3c;
    color: #2e7d32;
}

.notif-status-error {
    background-color: rgba(211, 47, 47, 0.2);
    border-color: #d32f2f;
    color: #c62828;
}

.notif-status-pending {
    background-color: rgba(33, 150, 243, 0.2);
    border-color: #1976d2;
    color: #1565c0;
}

.notif-chat-list {
    margin-top: 6px;
    border-width: 1px;
    border-color: var(--unity-colors-input_field-border, rgba(0, 0, 0, 0.25));
    border-radius: 4px;
    background-color: var(--unity-colors-input_field-background, rgba(0, 0, 0, 0.12));
    overflow: hidden;
    max-width: 100%;
}

.notif-chat-item {
    flex-direction: row;
    align-items: center;
    padding: 3px 6px;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-input_field-border, rgba(0, 0, 0, 0.1));
    max-width: 100%;
}

.notif-chat-item:hover {
    background-color: var(--unity-colors-highlight-background-hover, rgba(255, 255, 255, 0.04));
}

.notif-chat-id-label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-left: 6px;
    -unity-text-align: middle-left;
    overflow: hidden;
}
