.buildtool-settings-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

.buildtool-settings-scroll {
    flex-grow: 1;
    padding: 8px 12px;
}

.buildtool-page-title {
    font-size: 19px;
    -unity-font-style: bold;
    color: var(--unity-colors-default-text, #ffffff);
    margin-bottom: 8px;
    flex-shrink: 0;
}

.buildtool-section-card {
    background-color: var(--unity-colors-helpbox-background, rgba(0, 0, 0, 0.15));
    border-width: 1px;
    border-color: var(--unity-colors-helpbox-border, rgba(0, 0, 0, 0.25));
    border-radius: 5px;
    padding: 8px 10px;
    margin-top: 8px;
    max-width: 100%;
    flex-shrink: 0;
}

.buildtool-section-header-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
    max-width: 100%;
    flex-shrink: 0;
}

.buildtool-section-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--unity-colors-default-text, #e0e0e0);
    flex-shrink: 0;
}

.buildtool-hint-text {
    color: var(--unity-colors-default-text-hover, #999999);
    font-size: 11px;
    white-space: normal;
    margin-bottom: 6px;
    flex-shrink: 0;
}

.buildtool-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
    max-width: 100%;
    flex-shrink: 0;
}

.buildtool-field-flex {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 4px;
}

.buildtool-field-flex > .unity-base-field__label {
    min-width: 115px;
    max-width: 115px;
    width: 115px;
    flex-shrink: 0;
}

.buildtool-field-flex > .unity-base-field__input {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
}

.buildtool-field-flex .unity-text-element {
    overflow: hidden;
}

.buildtool-subtle-preview {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 4px;
    opacity: 0.85;
}

.buildtool-subtle-preview > .unity-base-field__label {
    min-width: 115px;
    max-width: 115px;
    width: 115px;
    flex-shrink: 0;
    color: var(--unity-colors-default-text-hover, #999999);
}

.buildtool-subtle-preview > .unity-base-field__input {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0.12);
    border-color: rgba(255, 255, 255, 0.05);
    color: var(--unity-colors-default-text-hover, #aaaaaa);
    border-radius: 3px;
    padding: 2px 6px;
}

.buildtool-subtle-preview .unity-text-element {
    overflow: hidden;
}

.buildtool-btn-tokens {
    height: 22px;
    min-width: 65px;
    padding-left: 6px;
    padding-right: 6px;
    border-radius: 3px;
    flex-shrink: 0;
}

.buildtool-btn-sm {
    height: 20px;
    width: 22px;
    min-width: 22px;
    max-width: 22px;
    padding: 0;
    margin-left: 4px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.buildtool-reload-btn {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 24px;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 3px;
    flex-shrink: 0;
}

.buildtool-btn-icon {
    width: 14px;
    height: 14px;
    margin-right: 6px;
    flex-shrink: 0;
}

.buildtool-btn-label {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--unity-colors-default-text, #e0e0e0);
    white-space: nowrap;
}

.buildtool-profile-card {
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: var(--unity-colors-helpbox-border, rgba(0, 0, 0, 0.25));
    border-radius: 5px;
    padding: 8px 10px;
    margin-top: 6px;
    max-width: 100%;
    flex-shrink: 0;
}

.buildtool-profile-card .unity-text-field__input {
    background-color: rgba(0, 0, 0, 0.22);
    border-color: rgba(0, 0, 0, 0.28);
}

.buildtool-profile-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
}

.buildtool-profile-name {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--unity-colors-default-text, #ffffff);
    flex-shrink: 1;
    overflow: hidden;
}

.buildtool-badge {
    padding: 1px 6px;
    border-radius: 3px;
    font-size: 9px;
    -unity-font-style: bold;
    background-color: #2b5b84;
    color: #ffffff;
    flex-shrink: 0;
    margin-left: 6px;
}

.buildtool-toggle {
    margin-top: 4px;
    margin-bottom: 4px;
}
